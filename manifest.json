{
  "manifest_version": 3,
  "name": "Markdown Viewer",
  "description": "브라우저에서 마크다운(.md) 파일을 아름답게 렌더링합니다.",
  "version": "1.0.0",
  "icons": {
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*/*.md",
        "*://*/*.md?*",
        "*://*/*.markdown",
        "*://*/*.markdown?*",
        "*://*/*.mdown",
        "*://*/*.mkd",
        "*://*/*.mkdn",
        "*://*/*.mdx",
        "file:///*/*.md",
        "file:///*/*.markdown",
        "file:///*/*.mdown",
        "file:///*/*.mkd",
        "file:///*/*.mkdn",
        "file:///*/*.mdx"
      ],
      "js": [
        "lib/marked.min.js",
        "lib/prism-bundle.js",
        "content.js"
      ],
      "css": [
        "lib/prism.css",
        "styles/markdown.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
